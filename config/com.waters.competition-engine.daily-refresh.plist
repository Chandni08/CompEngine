<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.waters.competition-engine.daily-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export AGILENT_HEADED=1; export PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Library/Frameworks/Python.framework/Versions/3.14/bin; cd /Users/chandni/Documents/CompetitionEngine &amp;&amp; /usr/bin/caffeinate -i /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 /Users/chandni/Documents/CompetitionEngine/scripts/refresh_daily.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/chandni/Documents/CompetitionEngine</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>ThrottleInterval</key>
  <integer>600</integer>

  <key>StandardOutPath</key>
  <string>/Users/chandni/Documents/CompetitionEngine/logs/daily-refresh.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/chandni/Documents/CompetitionEngine/logs/daily-refresh-error.log</string>
</dict>
</plist>
